{
  "url": "http://localhost:8766/",
  "viewport": [1920, 1080],
  "fps": 30,
  "quality": 80,
  "warmup": 45,
  "load_wait_ms": 1200,
  "clear_storage": true,
  "cine": {
    "container": ".scene-area",
    "canvas_host": "#scene",
    "background": "#18242a"
  },
  "ui_css": "#toast{transition:none!important}",
  "shots": {
    "hero":     {"mode": "cine", "frames": 255,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "1×"}}],
                 "actions": [{"drag": 220, "from": 0, "to": 254, "x0": 860, "y": 540}]},
    "ui":       {"mode": "ui", "frames": 240,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "3×"}}]},
    "interior": {"mode": "cine", "frames": 255,
                 "actions": [{"at": 6, "click": "廠房內部"},
                             {"drag": -120, "from": 90, "to": 254, "x0": 1000, "y": 540}]},
    "select":   {"mode": "ui", "frames": 240,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "3×"}}],
                 "actions": [{"at": 20, "click": "CNC-03"}]},
    "power":    {"mode": "cine", "frames": 255,
                 "setup": [{"click": "電力"}],
                 "actions": [{"drag": 160, "from": 0, "to": 254, "x0": 860, "y": 540}]},
    "solar":    {"mode": "cine", "frames": 255,
                 "setup": [{"click": "電力"}],
                 "actions": [{"at": 4, "click": "場外太陽能"},
                             {"drag": -140, "from": 80, "to": 254, "x0": 1100, "y": 540}]},
    "cloud":    {"mode": "ui", "frames": 240,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "3×"}}],
                 "actions": [{"at": 30, "click": "雲層遮蔽"}]},
    "fault":    {"mode": "ui", "frames": 240,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "3×"}}],
                 "actions": [{"at": 30, "click": "機台故障"}, {"at": 75, "click": "CNC-02"}]},
    "carbon":   {"mode": "cine", "frames": 255,
                 "setup": [{"click": "碳排"}],
                 "actions": [{"drag": -180, "from": 0, "to": 254, "x0": 1150, "y": 540}]},
    "add":      {"mode": "ui", "frames": 270,
                 "setup": [{"select": {"selector": "select", "index": -1, "label": "3×"}}],
                 "actions": [{"at": 20, "click": "新增"},
                             {"at": 40, "fill": {"selector": "#device-name", "value": ""}},
                             {"type": {"selector": "#device-name", "value": "CNC-07"}, "at": 42, "cps": 10},
                             {"at": 80, "click": "新增裝置"}]}
  }
}
